{
    "manifest_version": 3,
    "name": "AllBlocker",
    "version": "2.0.0",
    "description": "Bloqueia tudo sem dó",
    "icons": {
        "48": "icons/icon.svg"
    },
    "browser_specific_settings": {
        "gecko": {
            "id": "allblocker@wpx.softwares.com",
            "strict_min_version": "113.0",
            "data_collection_permissions": {
                "required": [
                    "none"
                ]
            }
        }
    },
    "permissions": [
        "declarativeNetRequest"
    ],
    "declarative_net_request": {
        "rule_resources": [
            {
                "id": "blocklist",
                "enabled": true,
                "path": "rules.json"
            }
        ]
    }
}
